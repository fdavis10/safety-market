{
	email {$ACME_EMAIL}
}

{$DOMAIN}, {$DOMAIN2} {
	encode gzip
	reverse_proxy web:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

www.{$DOMAIN2} {
	redir https://{$DOMAIN2}{uri} permanent
}
